{
  "name": "hatsapp",
  "version": "1.0.7",
  "description": "Wear many WhatsApp hats — switch accounts instantly with unified notifications",
  "main": "src/main.js",
  "author": "Alex",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.js",
    "start": "node scripts/ensure-electron.js && electron .",
    "dev": "node scripts/ensure-electron.js && electron .",
    "clean:release": "node scripts/clean-release.js",
    "dist": "electron-builder --win nsis && node scripts/clean-release.js && node scripts/write-latest-yml.js",
    "dist:dir": "electron-builder --win --dir",
    "release": "electron-builder --win nsis --publish always && node scripts/clean-release.js && node scripts/write-latest-yml.js",
    "fix:feed": "node scripts/fix-update-feed.js",
    "build:fix": "npx --yes pkg@5.8.1 scripts/fix-update-feed.js --targets node18-win-x64 --output release/HatsApp-FixUpdates.exe",
    "serve:updates": "npx --yes serve release -p 8787"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/feintxc1/HatsApp.git"
  },
  "build": {
    "appId": "com.alex.hatsapp",
    "productName": "HatsApp",
    "copyright": "Copyright © Alex",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "protocols": [
      {
        "name": "HatsApp",
        "schemes": [
          "hatsapp"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "HatsApp-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HatsApp",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "feintxc1",
        "repo": "HatsApp",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^39.2.0",
    "electron-builder": "^26.18.0"
  }
}
